#!/bin/bash
#SBATCH --job-name=uvcgan_pretrain
#SBATCH --output=logs/job_%j.out
#SBATCH --error=logs/job_%j.err
#SBATCH --partition=gpu            # Specify GPU partition/queue
#SBATCH --account=         # Replace GRANT_ID with your ICM grant number (e.g., g90-12)
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16GB
#SBATCH --gres=gpu:1               # Request 1 GPU
#SBATCH --time=01:00:00            # Walltime limit (HH:MM:SS)

# Create logs directory for job stdout/stderr
mkdir -p logs

# Navigate to working directory
cd /lu/tetyda/home/jk426853/MIMUW_Licencjat_Mat

# Activate virtual environment
source venv/bin/activate

# Set environment variables (use 'export' in Bash)
export UVCGAN2_DATA="/lu/tetyda/home/jk426853/MIMUW_Licencjat_Mat/crystal_data"
export UVCGAN2_OUTDIR="/lu/tetyda/home/jk426853/MIMUW_Licencjat_Mat/outdir"

# Execute training script
python uvcgan_training/pretrain_crystals.py